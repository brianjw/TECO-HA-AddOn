# Copy to .env (gitignored) and fill in. Never commit real credentials.
TECO_USER=your_portal_username
TECO_PASS=your_portal_password

# Optional shared secret. If set, the HA integration must send the same value
# as 'X-Auth-Token'. Generate one with: openssl rand -hex 24
SIDECAR_TOKEN=

# Re-login if the browser session is older than this many minutes.
SESSION_TTL_MIN=30

# Optional: push sensors + Energy Dashboard statistics into a standalone
# (non-Supervisor) Home Assistant Core install, e.g. HA running via
# docker-compose. Leave both blank to run dashboard/API-only.
# HA_URL is your HA base URL (or the HA container's service name if on the
# same Docker network). HA_TOKEN is a Long-Lived Access Token from your HA
# user profile (Profile -> Security -> Long-Lived Access Tokens).
HA_URL=
HA_TOKEN=
